# Copy to .env.local (never commit real secrets)

# PostgreSQL — required for Create account (User table) and persisting features via admin API.
#
# Local Docker DB (after: npm run db:up)
# DATABASE_URL="postgresql://hirvana:hirvana@localhost:5432/hirvana?schema=public"
#
# Hosted (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth — set NEXTAUTH_URL + NEXTAUTH_SECRET, then one or more sign-in methods:
# NEXTAUTH_URL must be a full URL (never leave blank — empty string breaks middleware in production).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email/password (single allowed user — bcrypt hash, not plain text)
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
HIRVANA_AUTH_EMAIL="you@example.com"
HIRVANA_AUTH_PASSWORD_HASH="$2a$10$..."

# GitHub OAuth (https://github.com/settings/developers → OAuth Apps)
GITHUB_ID="your-github-oauth-app-client-id"
GITHUB_SECRET="your-github-oauth-app-client-secret"

# Admin API: PUT /api/features, PATCH /api/features/:id
HIRVANA_ADMIN_SECRET="generate-a-long-random-string"

# Optional: OpenAI for free Resume hub optimiser (/api/resume/optimize — rules-only if unset)
# OPENAI_API_KEY="sk-..."

# Email via Resend (https://resend.com). Omit RESEND_API_KEY to skip account-created email.
# RESEND_API_KEY="re_..."
# SIGNUP_EMAIL_FROM="Hirvana <accounts@your-verified-domain.com>"

# --- Optional: /pay page (defaults exist in code if unset) ---
# NEXT_PUBLIC_UPI_ID="your@paytm"
# NEXT_PUBLIC_UPI_PAYEE_NAME="Hirvana"
# NEXT_PUBLIC_UPI_AMOUNT="499"

# =============================================================================
# Production (e.g. Vercel) — add these in Project → Settings → Environment Variables
# =============================================================================
# Never commit real values. Use Production (and Preview if you want) scopes.
#
# Required for a working public app:
#   DATABASE_URL          — Postgres connection string (Neon/Supabase often end with ?sslmode=require)
#   NEXTAUTH_URL          — Exact public origin, e.g. https://hirvana-mvp.vercel.app (no trailing slash OK;
#                           must NOT be an empty string). Can match your custom domain if you use one.
#   NEXTAUTH_SECRET       — openssl rand -base64 32
#
# At least one sign-in path (can combine):
#   (A) DATABASE_URL      — enables email/password for users in the User table (Create account + sign in)
#   (B) HIRVANA_AUTH_EMAIL + HIRVANA_AUTH_PASSWORD_HASH — ONE fixed login (no User row). Use in prod when you
#       want an owner/ops account that always works even if DB is down, or before anyone signs up via Create account.
#       Set BOTH in Vercel Production. Email must match exactly what you type on /login (case-insensitive).
#       Hash: from repo root run:
#         node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD',10))"
#       Paste the full $2a$... line as HIRVANA_AUTH_PASSWORD_HASH (never paste the plain password in Vercel).
#   (C) GITHUB_ID + GITHUB_SECRET — GitHub OAuth (callback URL in GitHub app must include
#       https://YOUR_DOMAIN/api/auth/callback/github)
#
# Strongly recommended:
#   HIRVANA_ADMIN_SECRET  — protects PUT/PATCH /api/features* (or legacy FEATURES_WRITE_SECRET)
#
# Optional:
#   OPENAI_API_KEY        — GPT path on POST /api/resume/optimize
#   RESEND_API_KEY        — “account created” email after sign-up
#   SIGNUP_EMAIL_FROM     — verified sender in Resend (else Resend onboarding sender)
#   NEXT_PUBLIC_UPI_*     — /pay QR defaults
#
# Vercel build: vercel.json runs `npm run vercel-build` (prisma migrate deploy + next build).
# Ensure DATABASE_URL is set before deploy so migrations succeed.
#
# Example shape (replace placeholders; omit optional lines you do not use):
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# NEXTAUTH_URL="https://hirvana-mvp.vercel.app"
# NEXTAUTH_SECRET="paste-output-of-openssl-rand-base64-32"
# HIRVANA_ADMIN_SECRET="long-random-string"
# GITHUB_ID="Iv1...."
# GITHUB_SECRET="..."
# HIRVANA_AUTH_EMAIL="ops@yourcompany.com"
# HIRVANA_AUTH_PASSWORD_HASH="$2a$10$..."
# OPENAI_API_KEY="sk-..."
# RESEND_API_KEY="re_..."
# SIGNUP_EMAIL_FROM="Hirvana <accounts@yourdomain.com>"
# NEXT_PUBLIC_UPI_ID="your@upi"
# NEXT_PUBLIC_UPI_PAYEE_NAME="Hirvana"
# NEXT_PUBLIC_UPI_AMOUNT="499"
